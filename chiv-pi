#!/usr/bin/env bash
set -euo pipefail

CHIV_PI_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
RESOLVER_URL="$(node -p 'require("node:url").pathToFileURL(process.argv[1]).href' "$CHIV_PI_ROOT/packages/coding-agent/src/experimental/source-resolver.ts")"
exec node --import "$RESOLVER_URL" "$CHIV_PI_ROOT/packages/coding-agent/src/cli.ts" "$@"
